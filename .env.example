# Copie para .env e ajuste. Configurações salvas pela tela Coordenação > IA têm prioridade.
# PORT=3000
# HOST=127.0.0.1          # use 0.0.0.0 para atender outras máquinas da rede (perfil C)
# AI_PROVIDER=ollama      # "ollama", "openai" ou vazio (IA desligada: só motor de regras)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b   # máquinas com 8 GB; qwen2.5:7b pede 8-16 GB livres
# OPENAI_API_KEY=sk-...
# SESSION_SECRET=troque-por-um-valor-longo-e-aleatorio
# Senha das contas iniciais (so na criacao do banco). Sem ela, uma senha
# aleatoria e gerada e mostrada no terminal e em data/senha-inicial.txt.
# SENHA_INICIAL=
